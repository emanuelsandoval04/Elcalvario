# Variables del servicio API en Railway, no de Vercel. Sin credenciales reales.
NODE_ENV=production
API_HOST=0.0.0.0
# Railway inyecta PORT. No hace falta crear PORT ni API_PORT.
APP_ORIGINS=https://tu-proyecto.vercel.app
TRUST_PROXY=1
SESSION_HOURS=8

# Referencias al servicio MySQL; cambia MySQL si tiene otro nombre en Railway.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
# false para MySQL por red privada de Railway, si no tiene TLS configurado.
# Para Aiven u otro proveedor con TLS: true y su CA en DB_SSL_CA.
DB_SSL=false
DB_SSL_CA=

# Opcionales: hay un enlace alternativo de transmisión si no configuras token.
FACEBOOK_PAGE_ID=61556906195984
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=
FACEBOOK_FALLBACK_VIDEO=https://www.facebook.com/61556906195984/videos/1641403047771920/
# Cifra el token de Meta que Multimedia guarda en el panel (32+ caracteres aleatorios).
TRANSMISSION_SECRET_KEY=
