# Desarrollo local. Copia este archivo a .env y ajusta tus credenciales.
# Para desplegar en Aiven y Vercel, usa .env.vercel.example.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=el_calvario
API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=0
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false
# Certificado CA en PEM; acepta saltos de línea reales o escritos como \n.
DB_SSL_CA=
SESSION_HOURS=8

# Recuperación por correo (opcional hasta configurarla). Claves solo del servidor.
# Destino de los enlaces de correo, incluso al ejecutar la API localmente.
APP_PUBLIC_URL=https://elcalvario.vercel.app
MAIL_PROVIDER=gmail
GMAIL_USER=
# Contraseña de aplicación de Google de 16 caracteres. No usar la contraseña normal.
GMAIL_APP_PASSWORD=
# Alternativa futura: MAIL_PROVIDER=resend y completar los siguientes valores.
RESEND_API_KEY=
# Correo de un dominio verificado en Resend, sin nombre ni corchetes.
RESEND_FROM_EMAIL=

# Clave pública del navegador: restringir por referentes HTTP y Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Meta: variables exclusivas del servidor. Nunca usar prefijo VITE_.
FACEBOOK_PAGE_ID=61556906195984
FACEBOOK_PAGE_ACCESS_TOKEN=
# Seleccionar una versión de Graph API habilitada para la aplicación de Meta.
FACEBOOK_GRAPH_VERSION=
FACEBOOK_FALLBACK_VIDEO=https://www.facebook.com/61556906195984/videos/1641403047771920/
# Cifra el token de Meta que Multimedia guarda en el panel (32+ caracteres aleatorios).
TRANSMISSION_SECRET_KEY=
