# Variables del proyecto Vercel: React y API se alojan juntos.
# Valores de ejemplo; carga los reales en Settings > Environment Variables.
NODE_ENV=production
DB_HOST=tu-servicio.d.aivencloud.com
DB_PORT=24970
DB_USER=calvario_app
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# Pega el certificado CA completo de Aiven. Acepta saltos reales o \n.
DB_SSL_CA=
DB_CONNECTION_LIMIT=2
DB_CONNECT_TIMEOUT_MS=10000
SESSION_HOURS=8
# Opcional para dominios personalizados. Vercel autoriza sus dominios propios.
APP_ORIGINS=

# Recuperación de contraseña. Dominio estable de producción, HTTPS y sin barra final.
APP_PUBLIC_URL=https://elcalvario.vercel.app
# Valores privados del servidor; nunca usar prefijo VITE_.
MAIL_PROVIDER=gmail
GMAIL_USER=
# Contraseña de aplicación de Google (16 caracteres), con verificación en dos pasos.
GMAIL_APP_PASSWORD=
# Alternativa futura: MAIL_PROVIDER=resend y usar dominio propio verificado.
RESEND_API_KEY=
# Dirección de un dominio verificado en Resend, p. ej. acceso@tudominio.com.
RESEND_FROM_EMAIL=

# Única clave pública que se incorpora al navegador.
VITE_GOOGLE_MAPS_API_KEY=

# Opcionales y privados: no uses prefijo VITE_ para estos valores.
FACEBOOK_PAGE_ID=61556906195984
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=
FACEBOOK_FALLBACK_VIDEO=https://www.facebook.com/61556906195984/videos/1641403047771920/
# Cifra el token de Meta que Multimedia guarda en el panel (32+ caracteres aleatorios).
TRANSMISSION_SECRET_KEY=
